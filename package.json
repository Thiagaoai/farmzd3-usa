{
  "name": "farmz3d-shop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002 --hostname localhost",
    "local": "node scripts/local-dev.mjs",
    "build": "next build",
    "postbuild": "mkdir -p .next/standalone/.next && cp -R public .next/standalone/public && cp -R .next/static .next/standalone/.next/static",
    "start": "PORT=${PORT:-3002} HOSTNAME=${HOSTNAME:-localhost} node .next/standalone/server.js",
    "lint": "eslint",
    "test": "node --experimental-strip-types --no-warnings --test \"tests/**/*.test.mts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@supabase/supabase-js": "^2.104.1",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "next": "^16.3.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "resend": "^6.12.2",
    "three": "^0.186.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^5"
  }
}
